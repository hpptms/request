# Loaded automatically by `vite build` (used by Cloudflare Pages' build
# step). The API is a separate origin now that the frontend ships from
# Cloudflare Pages instead of the same nginx container — see
# ~/.cloudflared/config.yml (api.request.tokyo ingress) and
# docker-compose.yml (backend FRONTEND_ORIGIN/SECURE_COOKIES).
VITE_API_BASE_URL=https://api.request.tokyo/api

# Affiliate IDs for the "この曲を探す" links (src/lib/affiliate.ts). These are
# public by nature — they appear in every generated link — so they are safe
# to commit; API keys/secrets must never go in a VITE_ variable (it ends up
# in the browser bundle). A blank/missing ID turns that link into a plain,
# non-affiliate search link.
VITE_AMAZON_TAG=itemsearch05-22
VITE_RAKUTEN_AFFILIATE_ID=560e48fa.f59f215f.560e48fb
