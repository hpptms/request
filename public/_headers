# Security headers for Cloudflare Pages, mirroring nginx.conf (still used
# for local Docker preview only — see docker-compose.yml). connect-src
# includes https://api.request.tokyo because the API is now a separate
# origin (see src/api.ts / .env.production) rather than same-origin /api.
# connect-src also lists https://analytics.google.com and
# https://www.google.com (bare domains, not just the *.google-analytics.com/
# *.analytics.google.com wildcards) because gtag.js actually sends its
# collect hits to those exact hosts — a wildcard like *.analytics.google.com
# does NOT match the bare analytics.google.com, so without these gtag.js/
# boot.js loaded fine but every hit was silently dropped by the CSP.
# img-src includes https://api.request.tokyo for the same cross-origin-API
# reason as connect-src above — the 意思表示 broadcast image is served
# from GET /api/broadcast/image, and without this the <img> tag showing it
# is silently blocked the same way gtag's hits were.
# The admax (Shinobi Tools) ads (FooterAd.tsx, PcRailAd.tsx) used to run
# directly in this document, but its RTB pipeline — its own scripts, plus
# whichever exchange/advertiser wins each auction, each with their own
# domains and inline <script> blocks — kept needing new script-src/img-src/
# connect-src entries here every time a different ad happened to win, since
# an about:blank iframe (which is how admax renders a creative) inherits
# the CSP of whatever page created it. Both ad units now load in a
# sandboxed same-origin iframe pointed at /ad/banner.html instead (see that
# file, and FooterAd.tsx/PcRailAd.tsx) — that page has no CSP of its own
# (see the /ad/* rule below), so this policy no longer needs any
# admax-specific entries at all. frame-src 'self' below is so the main
# document is allowed to embed that page.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.youtube.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com https://*.ytimg.com https://*.nimg.jp https://*.vimeocdn.com https://api.request.tokyo; frame-src 'self' https://www.youtube.com https://embed.nicovideo.jp https://player.vimeo.com; connect-src 'self' https://api.request.tokyo https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://www.google.com https://www.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# admax's ad tags (script-src-elem, inline scripts, img-src beacons, ...)
# need to run without this site's CSP restricting them (see the comment on
# the /* rule above) — this page is only ever embedded via a sandboxed
# iframe with no allow-same-origin (FooterAd.tsx/PcRailAd.tsx), so it never
# runs with request.tokyo's real origin regardless of what it's allowed to
# load. X-Frame-Options is relaxed to SAMEORIGIN (from the site-wide DENY)
# only so request.tokyo itself can embed this one path; frame-ancestors
# 'none' from the negated CSP would otherwise block that too.
/ad/*
  ! Content-Security-Policy
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN
