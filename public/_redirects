# /report (the public GA4 snapshot report page) was removed, but Google
# still had it indexed and GA4's tag coverage kept listing it as an
# untagged page — with no matching route the SPA rendered a blank page, so
# no page_view ever fired there. Send it (and any old links) to the board.
/report   /  301
/report/  /  301

# Dated stats pages (/stats/2026-11-13, /stats/week/..., see
# src/lib/statsPath.ts) get the prerendered stats page without its /stats
# canonical (see prerenderSeo in vite.config.ts) instead of the home page's.
# No ".html" on the target: Pages answers that with a 308 to /stats-dated,
# which would replace the address the visitor asked for.
/stats/*  /stats-dated  200

