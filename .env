# Site-wide public IDs, loaded by Vite in every mode (dev and build). These
# all end up in the browser bundle / served HTML — so they are not secret
# and safe to commit — and are kept here rather than in source so they can
# be changed (or overridden locally via a gitignored .env.local) in one
# place. API keys/secrets must never go in a VITE_ variable.

# GA4 measurement ID (G-...), used by index.html and public/boot.js. GA only
# reports from request.tokyo hosts regardless (see boot.js).
VITE_GA_MEASUREMENT_ID=G-8L7G9DTTF8

# Google AdSense publisher client (ca-pub-...), used by index.html. Must
# match the pub-... line in public/ads.txt.
VITE_ADSENSE_CLIENT=ca-pub-5157294493857921

# admax (忍者AdMax) units, loaded from <VITE_ADS_ORIGIN>/ad/banner?tag=...
# (src/lib/ninjaAds.ts). A unit with a blank tag (or blank origin) is hidden.
VITE_ADS_ORIGIN=https://ads.request.tokyo
VITE_ADMAX_TAG_MOBILE_ANCHOR=23aa468c68dd9f337c4c77c42e885ffa
VITE_ADMAX_TAG_PC_RAIL=cd45827394e2a2c014eb20d9bfe1c51a
VITE_ADMAX_TAG_PLAY_QUEUE=81a7e2cac2837657568af6a07ec1b354

# X (Twitter) handle without "@" for the /contact page and index.html's
# structured data. Blank shows「準備中」on /contact.
VITE_X_HANDLE=request_tokyo
