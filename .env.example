# Only needed if the API is served from a different origin than the
# frontend (the default "/api" relative path works with both the Docker/
# nginx setup and the Vite dev proxy in vite.config.ts).
# VITE_API_BASE_URL=http://localhost:8090/api

# Port the Go backend listens on when running `npm run dev` locally
# (used by the Vite dev proxy in vite.config.ts).
BACKEND_PORT=8090

# Affiliate IDs for the "この曲を探す" links (see .env.production). Leave
# blank locally to get plain search links.
# VITE_AMAZON_TAG=
# VITE_RAKUTEN_AFFILIATE_ID=

# Site-wide IDs. Copy into .env (gitignored, loaded in every mode) for local
# dev; production builds on Cloudflare Pages get them from the project's
# environment variables instead. Any left blank just turns that feature off
# (no GA reporting, the admax unit hidden, /contact shows「準備中」).
VITE_GA_MEASUREMENT_ID=
VITE_ADSENSE_CLIENT=
VITE_ADS_ORIGIN=
VITE_ADMAX_TAG_MOBILE_ANCHOR=
VITE_ADMAX_TAG_PC_RAIL=
VITE_ADMAX_TAG_PLAY_QUEUE=
VITE_X_HANDLE=
