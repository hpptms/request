# Only needed if the API is served from a different origin than the
# frontend (the default "/api" relative path works with both the Docker/
# nginx setup and the Vite dev proxy in vite.config.ts).
# VITE_API_BASE_URL=http://localhost:8090/api

# Port the Go backend listens on when running `npm run dev` locally
# (used by the Vite dev proxy in vite.config.ts).
BACKEND_PORT=8090
